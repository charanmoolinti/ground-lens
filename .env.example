# GROUND LENS Environment Variables

# Google Gemini API Key (Required for LLM generation & structured claim extraction)
# Get your key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Preferred Gemini Model (Defaults to gemini-2.0-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.0-flash

# ChromaDB Persistence Directory
CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# Embedding & NLI Models
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
NLI_MODEL_NAME=cross-encoder/nli-deberta-v3-base

# NLI Thresholds
NLI_SUPPORT_THRESHOLD=0.60
NLI_CONTRADICT_THRESHOLD=0.60
